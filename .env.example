# Konfigurasi Qdrant Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=artikel_kesehatan

# Konfigurasi Ollama Service
# Jika di server lokal / Docker: gunakan http://host.docker.internal:11434
# Jika Ollama di server lain: ganti dengan http://<ip-server>:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3-medis
LLM_EVAL_MODEL=qwen3:1.7b
EMBEDDING_MODEL=bge-m3

# Parameter Retrieval & Threshold
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K_RETRIEVAL=7
SCORE_THRESHOLD=0.55
