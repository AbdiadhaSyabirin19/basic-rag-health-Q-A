# Konfigurasi Qdrant Vector DB
# Gunakan localhost jika menjalankan script python dari terminal host (Windows)
# Gunakan qdrant jika berjalan di dalam container Docker
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=artikel_kesehatan

# Konfigurasi Ollama Service
# Gunakan http://localhost:11434 jika menjalankan script dari terminal host (Windows)
# Gunakan http://ollama:11434 jika berjalan di dalam container Docker
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3-medis
LLM_EVAL_MODEL=qwen3:1.7b
EMBEDDING_MODEL=bge-m3

# Parameter Retrieval & Threshold
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K_RETRIEVAL=7
SCORE_THRESHOLD=0.55
